[Unit]
Description=MEDI authenticated encrypted backup
RequiresMountsFor=/mnt/medi-offsite
After=docker.service
[Service]
Type=oneshot
User=medi-operator
Group=medi-operator
SupplementaryGroups=docker
UMask=0077
ExecStart=/usr/bin/node /opt/medi/tooling/production-schedule.mjs /var/lib/medi-install /var/lib/medi-backup-custody/backup.key
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/medi-offsite /var/lib/medi-install
TimeoutStartSec=15min
