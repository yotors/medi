# Local synthetic development only. npm run db:local creates random credentials.
POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgresql://hospital_dev:replace-with-random-local-password@127.0.0.1:15432/hospital_dev
APP_ORIGIN=http://127.0.0.1:5173
PORT=3100
NODE_ENV=development
# Explicitly permitted only for unenrolled synthetic development accounts.
STAFF_MFA_POLICY=synthetic
# Required policy/production must supply a private JSON keyring (see docs/staff-mfa.md).
# STAFF_MFA_KEYRING_FILE=/private/path/mfa-keyring.json
