{
  "name": "medi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Medi hospital management web application",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "doctor": "node tooling/doctor.mjs",
    "test:tooling": "playwright test",
    "audit:ui": "node tooling/audit-ui.mjs",
    "security:source": "python3 tooling/check.py semgrep",
    "security:dependencies": "python3 tooling/check.py trivy",
    "security:web": "python3 tooling/check.py zap",
    "test:load": "python3 tooling/check.py k6",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run shared",
    "db:local": "node tooling/local-db.mjs",
    "dev:api": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "setup:staff": "node --env-file-if-exists=.env --import tsx server/setup.ts",
    "test:server": "STAFF_MFA_POLICY=synthetic node --env-file-if-exists=.env --import tsx --test server/registration.test.ts server/outpatient.test.ts server/administration.test.ts server/configuration.test.ts server/billing.test.ts server/clinical.test.ts server/inventory.test.ts server/reports.test.ts server/mfa.test.ts server/mfa-readiness.test.ts server/care.test.ts server/departments.test.ts server/hospital.test.ts server/care-time.test.ts server/care-validation.test.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:staff": "playwright test --config=playwright.staff.config.ts",
    "db:migrate": "npm run setup:staff -- migrate",
    "db:backup": "node --env-file-if-exists=.env tooling/database.mjs backup",
    "db:restore-check": "node --env-file-if-exists=.env tooling/database.mjs restore-check",
    "release:local": "node tooling/release-local.mjs up",
    "release:stop": "node tooling/release-local.mjs stop",
    "release:status": "node tooling/release-local.mjs status",
    "release:verify": "node tooling/release-verify.mjs",
    "release:key-init": "node tooling/release-backup.mjs key-init",
    "release:backup": "node tooling/release-backup.mjs backup",
    "release:recover-check": "node tooling/release-recovery.mjs",
    "release:recovery-drill": "node tooling/release-recovery-drill.mjs",
    "test:release-recovery": "node --test tooling/release-backup.test.mjs tooling/release-inventory.test.mjs",
    "release:mfa": "node tooling/release-mfa.mjs",
    "setup:mfa": "node --env-file-if-exists=.env --import tsx server/mfa-setup.ts",
    "test:mfa": "node --env-file-if-exists=.env --import tsx --test server/mfa.test.ts server/mfa-readiness.test.ts",
    "test:mfa:browser": "playwright test --config=playwright.mfa.config.ts",
    "test:mfa:runtime": "node tooling/mfa-runtime-check.mjs",
    "test:mfa:artifacts": "node tooling/mfa-artifact-check.mjs",
    "test:operations": "node --env-file-if-exists=.env --import tsx --test server/observability.test.ts server/schema.test.ts server/operations.test.ts",
    "release:observability": "node tooling/observability-verify.mjs",
    "release:upgrade-check": "node tooling/upgrade-verify.mjs",
    "install:preflight": "node tooling/install-preflight.mjs",
    "release:capacity-check": "node tooling/capacity-verify.mjs",
    "release:preflight": "node tooling/release-preflight.mjs",
    "test:operations:tooling": "node --test tooling/install-preflight.test.mjs",
    "production:install": "node tooling/production-install.mjs",
    "production:backup": "node tooling/production-backup.mjs",
    "production:schedule": "node tooling/production-schedule.mjs",
    "test:production": "node tooling/production-install.test.mjs",
    "production:verify": "node tooling/production-drill.mjs",
    "format": "prettier --write src shared server tooling deploy tests *.ts *.json *.yaml .github/workflows",
    "format:check": "prettier --check src shared server tooling deploy tests *.ts *.json *.yaml .github/workflows",
    "test:localization": "node --test tooling/check-localization.test.mjs && vitest run src/staff/choice-label.test.ts && node tooling/check-localization.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/parser": "8.0.7",
    "@playwright/mcp": "0.0.83",
    "@playwright/test": "1.64.0",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@upstash/context7-mcp": "4.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "bmad-method": "6.12.2",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "bmad-method": {
      "csv-parse": "7.0.3"
    }
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/noto-sans-ethiopic": "5.3.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "fastify": "5.12.7",
    "i18next": "26.4.5",
    "lucide-react": "1.56.0",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "zod": "4.6.7"
  }
}
