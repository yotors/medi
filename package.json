{
  "name": "hospital-workspace-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Locally persisted synthetic outpatient workflow prototype and verification tools.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "doctor": "node tooling/doctor.mjs",
    "test:tooling": "playwright test",
    "audit:ui": "node tooling/audit-ui.mjs",
    "security:source": "python3 tooling/check.py semgrep",
    "security:dependencies": "python3 tooling/check.py trivy",
    "security:web": "python3 tooling/check.py zap",
    "test:load": "python3 tooling/check.py k6",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:app": "playwright test --config=playwright.app.config.ts",
    "db:local": "node tooling/local-db.mjs",
    "dev:api": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "setup:staff": "node --env-file-if-exists=.env --import tsx server/setup.ts",
    "test:server": "node --env-file-if-exists=.env --import tsx --test server/registration.test.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:staff": "playwright test --config=playwright.staff.config.ts",
    "db:migrate": "npm run setup:staff -- migrate"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/mcp": "0.0.83",
    "@playwright/test": "1.64.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@upstash/context7-mcp": "4.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "bmad-method": "6.12.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "bmad-method": {
      "csv-parse": "7.0.3"
    }
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "fastify": "5.12.7",
    "lucide-react": "1.56.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  }
}
